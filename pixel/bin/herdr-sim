#!/usr/bin/env python3
"""herdr-sim: a booted iOS simulator or Android device, live in a Herdr terminal pane.

Frames are drawn with the Kitty graphics protocol (Herdr terminals support it); each
frame replaces the last, so memory stays flat. Click to tap, drag to swipe.
Android taps and typing go through adb. simctl cannot tap, so iOS taps, swipes,
typing and Home go through Maestro (`maestro mcp`, kept running: ~10s for the first
step, then ~1.2s each) when Maestro and a Java runtime are installed.

Keys: n next device · h home · b back (Android) · t type text · d dark/light
      s screenshot to Desktop · o open Simulator.app · B boot an iPhone · q quit
"""
import base64, fcntl, hashlib, json, os, queue, select, shutil, signal, struct, subprocess, sys, tempfile, termios, threading, time, tty

FRAME_SECONDS = 0.4  # ponytail: screenshot polling (~2 fps); a video stream if smooth motion matters
TMP = tempfile.mkdtemp(prefix="herdr-sim-")
MAESTRO_HINT = "iOS input needs Maestro and Java: brew install mobile-dev-inc/tap/maestro openjdk@17"


def java_home():
    """Maestro needs Java: JAVA_HOME, else a Homebrew OpenJDK or Android Studio's runtime."""
    for home in (os.environ.get("JAVA_HOME"), "/opt/homebrew/opt/openjdk@17", "/opt/homebrew/opt/openjdk",
                 "/usr/local/opt/openjdk@17", "/Applications/Android Studio.app/Contents/jbr/Contents/Home"):
        if home and os.path.exists(os.path.join(home, "bin", "java")):
            return home
    return None


class Maestro:
    """iOS input through one long-running `maestro mcp`. Steps queue on a worker thread
    so frames keep coming while a tap is in flight."""

    def __init__(self, note):
        self.note = note  # callback: text for the status line ("" clears it)
        self.jobs = queue.Queue()
        self.proc = None
        self.n = 0
        self.used = set()  # device ids, to stop their drivers on quit
        threading.Thread(target=self.work, daemon=True).start()

    @staticmethod
    def available():
        return bool(shutil.which("maestro") and java_home())

    def send(self, device, steps):
        self.jobs.put((device, steps))

    def rpc(self, method, params=None):
        self.n += 1
        self.proc.stdin.write(json.dumps({"jsonrpc": "2.0", "id": self.n, "method": method, "params": params or {}}) + "\n")
        self.proc.stdin.flush()
        while True:
            line = self.proc.stdout.readline()
            if not line:
                raise RuntimeError("Maestro stopped")
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            if msg.get("id") == self.n:
                return msg

    def start(self):
        home = java_home()
        env = dict(os.environ, JAVA_HOME=home, PATH=f"{home}/bin:{os.environ.get('PATH', '')}")
        self.proc = subprocess.Popen(["maestro", "mcp", "--no-viewer"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL, text=True, env=env)
        self.rpc("initialize", {"protocolVersion": "2024-11-05", "capabilities": {}, "clientInfo": {"name": "herdr-sim", "version": "1"}})
        self.proc.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
        self.proc.stdin.flush()

    def work(self):
        while True:
            device, steps = self.jobs.get()
            self.used.add(device)
            try:
                if not self.proc or self.proc.poll() is not None:
                    self.note("Starting Maestro (the first step takes ~10s)…")
                    self.start()
                # The appId header is required; point taps, swipes, typing and Home don't use it.
                yaml = "appId: com.apple.springboard\n---\n" + "".join(steps)
                msg = self.rpc("tools/call", {"name": "run", "arguments": {"device_id": device, "yaml": yaml}})
                self.note(self.outcome(msg))
            except Exception as e:  # keep the pane alive; the next step restarts Maestro
                self.note(f"Maestro: {e}")
                self.close()

    @staticmethod
    def outcome(msg):
        """Status-line text for a tools/call reply: "" on success, else Maestro's message.
        A success is JSON text; a failure (isError) is plain text such as
        "Failed to run flow: Device with id … is not connected"."""
        if "error" in msg:
            return f"Maestro: {msg['error'].get('message', 'step failed')}"
        res = msg.get("result", {})
        text = (res.get("content") or [{}])[0].get("text", "")
        try:
            data = json.loads(text)
        except ValueError:
            data = {"success": False, "message": text}
        if not res.get("isError") and data.get("success"):
            return ""
        return f"Maestro: {(data.get('message') or 'step failed').removeprefix('Failed to run flow: ')}"

    def quit(self):
        """Stop Maestro and the XCTest driver it leaves running on each device it drove."""
        self.close()
        for device in self.used:
            run(["pkill", "-f", f"xcodebuild test-without-building -xctestrun .*{device}"])

    def close(self):
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
        self.proc = None


def run(args, timeout=10, **kw):
    try:
        return subprocess.run(args, capture_output=True, timeout=timeout, **kw)
    except (OSError, subprocess.TimeoutExpired):
        return None


def devices():
    found = []
    r = run(["xcrun", "simctl", "list", "devices", "booted", "-j"], text=True)
    if r and r.returncode == 0:
        for runtime, ds in json.loads(r.stdout)["devices"].items():
            for d in ds:
                if d.get("state") == "Booted" and all(f["id"] != d["udid"] for f in found):
                    found.append({"kind": "ios", "id": d["udid"], "name": d["name"]})
    r = run(["adb", "devices", "-l"], text=True) if shutil.which("adb") else None
    if r and r.returncode == 0:
        for line in r.stdout.splitlines()[1:]:
            parts = line.split()
            if len(parts) >= 2 and parts[1] == "device":
                model = next((p.split(":", 1)[1] for p in parts if p.startswith("model:")), parts[0])
                found.append({"kind": "android", "id": parts[0], "name": model.replace("_", " ")})
    return found


def grab(dev, path):
    """One screenshot as PNG; returns its bytes or None."""
    if dev["kind"] == "ios":
        r = run(["xcrun", "simctl", "io", dev["id"], "screenshot", "--type=png", path])
        return open(path, "rb").read() if r and r.returncode == 0 and os.path.exists(path) else None
    r = run(["adb", "-s", dev["id"], "exec-out", "screencap", "-p"])
    return r.stdout if r and r.returncode == 0 and r.stdout[:4] == b"\x89PNG" else None


def png_size(data):
    return struct.unpack(">II", data[16:24])


def winsize():
    rows, cols, xpix, ypix = struct.unpack("HHHH", fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8))
    # Without pixel sizes, assume a typical 1:2 cell.
    cw, ch = (xpix / cols, ypix / rows) if xpix and ypix else (8.0, 16.0)
    return rows, cols, cw, ch


def out(s):
    sys.stdout.write(s)
    sys.stdout.flush()


def kitty_image(data, cols, rows):
    """Transmit and show a PNG at the cursor over cols x rows cells, replacing image 1."""
    b64 = base64.standard_b64encode(data).decode()
    chunks = [b64[i:i + 4096] for i in range(0, len(b64), 4096)]
    parts = []
    for n, chunk in enumerate(chunks):
        more = 1 if n < len(chunks) - 1 else 0
        head = f"a=T,f=100,i=1,q=2,C=1,c={cols},r={rows},m={more}" if n == 0 else f"m={more}"
        parts.append(f"\x1b_G{head};{chunk}\x1b\\")
    out("".join(parts))


class Sim:
    def __init__(self):
        self.devs = devices()
        self.i = 0
        self.frame = None  # last PNG bytes
        self.digest = None
        self.box = None  # (left col, top row, cols, rows) of the image, 0-based
        self.note = ""
        self.dark = {}
        self.press = None
        self.dirty = True
        self.maestro = Maestro(self.set_note) if Maestro.available() else None

    def set_note(self, text):
        self.note, self.dirty = text, True

    def ios(self, *steps):
        """Run Maestro steps on the shown iOS simulator, or say what's missing."""
        if self.maestro:
            self.maestro.send(self.dev["id"], steps)
        else:
            self.note = MAESTRO_HINT

    @property
    def dev(self):
        return self.devs[self.i % len(self.devs)] if self.devs else None

    def status(self, cols):
        d = self.dev
        name = f"{d['name']} ({'iOS' if d['kind'] == 'ios' else 'Android'})" if d else "No booted simulator or Android device"
        keys = "n next  h home  t type  d dark  s shot  o Simulator  q quit" if d else "B boot an iPhone  q quit"
        rest = (self.note or keys)[: max(0, cols - len(name) - 5)]
        return f" \x1b[1m{name}\x1b[22m  \x1b[2m{rest}\x1b[22m\x1b[K"


    def draw(self, force=False):
        rows, cols, cw, ch = winsize()
        out("\x1b[H" + self.status(cols))
        if not self.frame:
            if force or self.dirty:
                out("\x1b[2;1H\x1b[J")
            self.dirty = False
            return
        w, h = png_size(self.frame)
        avail_c, avail_r = cols, max(1, rows - 1)
        scale = min(avail_c * cw / w, avail_r * ch / h)
        ic, ir = max(1, int(w * scale / cw)), max(1, int(h * scale / ch))
        left, top = (cols - ic) // 2, 1
        if force or self.dirty or self.box != (left, top, ic, ir):
            out("\x1b[2;1H\x1b[J")
        self.box = (left, top, ic, ir)
        out(f"\x1b[{top + 1};{left + 1}H")
        kitty_image(self.frame, ic, ir)
        self.dirty = False

    def refresh(self):
        d = self.dev
        if not d:
            return False
        data = grab(d, os.path.join(TMP, "frame.png"))
        if not data:
            self.note = "Couldn't grab a frame (device gone?). n: next, q: quit"
            return True
        digest = hashlib.sha1(data).digest()
        if digest == self.digest:
            return False
        self.frame, self.digest = data, digest
        return True

    # Device actions ----------------------------------------------------------

    def to_device(self, col, row):
        """Cell (0-based) -> device pixel, or None outside the image."""
        if not self.box or not self.frame:
            return None
        left, top, ic, ir = self.box
        if not (left <= col < left + ic and top <= row < top + ir):
            return None
        w, h = png_size(self.frame)
        return int((col - left + 0.5) / ic * w), int((row - top + 0.5) / ir * h)

    def percent(self, x, y):
        w, h = png_size(self.frame)
        return f'"{round(x * 100 / w)}%,{round(y * 100 / h)}%"'

    def tap(self, x, y):
        d = self.dev
        if d["kind"] == "android":
            run(["adb", "-s", d["id"], "shell", "input", "tap", str(x), str(y)])
        else:
            self.ios(f"- tapOn:\n    point: {self.percent(x, y)}\n")

    def swipe(self, a, b):
        d = self.dev
        if d["kind"] == "android":
            run(["adb", "-s", d["id"], "shell", "input", "swipe", *map(str, (*a, *b)), "250"])
        else:
            self.ios(f"- swipe:\n    start: {self.percent(*a)}\n    end: {self.percent(*b)}\n    duration: 300\n")

    def key(self, c):
        if c in "\r\n":
            return
        d = self.dev
        self.note = ""
        if c == "q":
            raise SystemExit
        if c == "B":
            r = run(["xcrun", "simctl", "list", "devices", "available", "-j"], text=True)
            phones = [x for ds in json.loads(r.stdout)["devices"].values() for x in ds if "iPhone" in x["name"]] if r else []
            if phones:
                run(["xcrun", "simctl", "boot", phones[0]["udid"]], timeout=120)
                self.note = f"Booted {phones[0]['name']}"
            self.devs, self.dirty = devices(), True
            return
        if c == "n":
            self.devs = devices()
            self.i += 1
            self.frame = self.digest = None
            self.dirty = True
            return
        if not d:
            return
        if c == "h":
            if d["kind"] == "android":
                run(["adb", "-s", d["id"], "shell", "input", "keyevent", "3"])
            else:
                self.ios("- pressKey: Home\n")
        elif c == "b" and d["kind"] == "android":
            run(["adb", "-s", d["id"], "shell", "input", "keyevent", "4"])
        elif c == "d":
            dark = not self.dark.get(d["id"], False)
            self.dark[d["id"]] = dark
            if d["kind"] == "ios":
                run(["xcrun", "simctl", "ui", d["id"], "appearance", "dark" if dark else "light"])
            else:
                run(["adb", "-s", d["id"], "shell", "cmd", "uimode", "night", "yes" if dark else "no"])
            self.note = f"{'Dark' if dark else 'Light'} mode"
        elif c == "s" and self.frame:
            path = os.path.expanduser(f"~/Desktop/{d['name'].replace(' ', '-')}-{time.strftime('%Y%m%d-%H%M%S')}.png")
            open(path, "wb").write(self.frame)
            self.note = f"Saved {path}"
        elif c == "o" and d["kind"] == "ios":
            run(["open", "-a", "Simulator"])
        elif c == "t":
            self.type_text()

    def type_text(self):
        rows, cols, _, _ = winsize()
        out("\x1b[H\x1b[K \x1b[1mType, then Enter (Esc cancels):\x1b[22m \x1b[1;35H\x1b[?25h")
        text, buf = "", b""
        while True:
            b = os.read(0, 1)
            if b in (b"\r", b"\n"):
                break
            if b == b"\x1b":
                text = ""
                break
            if b == b"\x7f":
                text = text[:-1]
            else:
                buf += b
                try:
                    text += buf.decode()
                    buf = b""
                except UnicodeDecodeError:
                    continue
            out(f"\x1b[1;35H\x1b[K{text[-(cols - 37):]}")
        out("\x1b[?25l")
        d = self.dev
        if text and d["kind"] == "android":
            run(["adb", "-s", d["id"], "shell", "input", "text", text.replace(" ", "%s")])
        elif text:
            self.ios(f"- inputText: {json.dumps(text)}\n")
        self.dirty = True

    def mouse(self, seq):
        # SGR: "<b;x;yM" (press/drag) or "<b;x;ym" (release), 1-based cells.
        b, x, y = seq[1:-1].split(";")
        b, cell = int(b), (int(x) - 1, int(y) - 1)
        if seq.endswith("M") and b == 0:
            self.press = cell
        elif seq.endswith("m") and self.press is not None:
            start, self.press = self.press, None
            a, z = self.to_device(*start), self.to_device(*cell)
            if a and z:
                moved = abs(start[0] - cell[0]) + abs(start[1] - cell[1])
                self.swipe(a, z) if moved > 1 else self.tap(*a)


def main():
    if not sys.stdout.isatty():
        sys.exit("herdr-sim runs in a terminal pane.")
    sim = Sim()
    old = termios.tcgetattr(0)
    tty.setcbreak(0)
    resized = []
    signal.signal(signal.SIGWINCH, lambda *_: resized.append(1))
    out("\x1b[?1049h\x1b[?25l\x1b[?1000h\x1b[?1002h\x1b[?1006h")
    try:
        next_frame = 0.0
        while True:
            if time.monotonic() >= next_frame:
                if sim.refresh() or sim.dirty:
                    sim.draw()
                next_frame = time.monotonic() + FRAME_SECONDS
            if resized:
                resized.clear()
                sim.draw(force=True)
            r, _, _ = select.select([0], [], [], 0.05)
            if not r:
                continue
            data = os.read(0, 4096).decode(errors="ignore")
            while data:
                if data.startswith("\x1b[<"):
                    end = min((i for i in (data.find("M"), data.find("m")) if i > 0), default=-1)
                    if end < 0:
                        break
                    sim.mouse(data[2:end + 1])
                    data = data[end + 1:]
                else:
                    sim.key(data[0])
                    data = data[1:]
                sim.draw()
                next_frame = time.monotonic() + 0.15  # show the result of a tap soon
    except (SystemExit, KeyboardInterrupt):
        pass
    finally:
        if sim.maestro:
            sim.maestro.quit()
        out("\x1b_Ga=d,d=A,q=2\x1b\\\x1b[?1006l\x1b[?1002l\x1b[?1000l\x1b[?25h\x1b[?1049l")
        termios.tcsetattr(0, termios.TCSADRAIN, old)
        shutil.rmtree(TMP, ignore_errors=True)


if __name__ == "__main__":
    main()
